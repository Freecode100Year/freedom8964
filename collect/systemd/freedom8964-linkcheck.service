[Unit]
Description=freedom8964 每周死链检查
[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/sites/freedom8964/collect/linkcheck.py
ExecStopPost=/bin/sh -c 'if [ "$$SERVICE_RESULT" != success ]; then %h/bin/tg-send "⚠️ freedom8964-linkcheck 运行失败（$$SERVICE_RESULT / $$EXIT_STATUS），查看：journalctl --user -u freedom8964-linkcheck"; fi'
TimeoutStartSec=3600
